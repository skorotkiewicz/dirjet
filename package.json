{
  "name": "dirjet",
  "version": "0.1.2",
  "description": "Serve directories and individual files with a Rust static file server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skorotkiewicz/dirjet.git"
  },
  "bugs": "https://github.com/skorotkiewicz/dirjet/issues",
  "bin": {
    "dirjet": "bin/dirjet.cjs"
  },
  "files": ["bin", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "keywords": ["serve", "static", "server", "rust", "bun"],
  "scripts": {
    "docs": "cargo run -- docs/",
    "dev": "cargo run --",
    "build": "cargo build --release --locked",
    "test": "cargo test --locked && bun test",
    "check": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "package": "cargo build --release --locked && bun scripts/package.mjs --local",
    "release:publish": "bun scripts/publish-npm.mjs dist/tarballs",
    "prepublishOnly": "bun scripts/verify-release.mjs dist"
  }
}
